# ==============================================
# فایل نمونه متغیرهای محیطی
# این فایل را کپی کرده و به نام .env ذخیره کنید
# سپس مقادیر واقعی خود را جای‌گزین کنید.
# هرگز فایل .env واقعی را در گیت‌هاب یا هر جای عمومی قرار ندهید.
# ==============================================

# آدرس اشتراک (Subscription URL) پنل پاسارگاد - این مقدار محرمانه است
PASSARGAD_SUB_URL=https://panel.bizimishimiz.info:8000/sub/djMsMTgyNjEsMTc4NTc5MjcwOA.Fw64Qax8cWHdz79uhuBARHPQpwrzMObHkhdR136RsoE

# توکن دسترسی شخصی گیت‌هاب (Personal Access Token) با دسترسی نوشتن روی مخزن
GITHUB_TOKEN=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

# نام کاربری یا سازمان صاحب مخزن گیت‌هاب
GITHUB_OWNER=moadabconnection

# نام مخزن گیت‌هابی که فایل اشتراک در آن نگهداری می‌شود
GITHUB_REPOSITORY=moadabconnection

# نام برنچی که فایل باید در آن به‌روزرسانی شود
GITHUB_BRANCH=main

# نام فایل مقصد در مخزن (همان فایلی که به مشتریان داده می‌شود)
GITHUB_FILE=unlimited.txt

# حداکثر زمان انتظار برای هر درخواست شبکه‌ای (بر حسب ثانیه)
TIMEOUT=30

